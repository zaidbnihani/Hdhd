<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#181818">

    <!-- شريط الـ Shorts العلوي -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#F15B5B"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- أيقونة Z -->
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ztube_icon"
                android:contentDescription="ZTube"
                android:scaleType="centerInside" />

            <!-- عنوان التطبيق -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp" />

            <!-- زر Shorts -->
            <Button
                android:id="@+id/btn_shorts_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_shorts"
                android:textColor="#F15B5B"
                android:textStyle="bold"
                android:backgroundTint="#FFFFFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- محتوى الواجهة الرئيسية -->
    <FrameLayout
        android:id="@+id/browse_content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>